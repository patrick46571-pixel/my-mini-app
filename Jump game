<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    >

    <title>Tap to Jump</title>

    <link rel="stylesheet" href="style.css">

    <!-- Telegram Mini App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>

<body>

    <main class="app">

        <!-- Header -->
        <header class="topbar">
            <div class="profile">
                <div id="avatar" class="avatar">?</div>

                <div>
                    <div id="username" class="username">
                        Player
                    </div>

                    <div class="player-label">
                        Tap to Jump
                    </div>
                </div>
            </div>

            <button id="soundButton" class="icon-button">
                🔊
            </button>
        </header>


        <!-- Score -->
        <section class="score-area">
            <div class="score-label">
                SCORE
            </div>

            <div id="score" class="score">
                0
            </div>

            <div class="best-score">
                BEST:
                <span id="bestScore">0</span>
            </div>
        </section>


        <!-- Game -->
        <section id="gameContainer" class="game-container">

            <canvas id="gameCanvas"></canvas>

            <!-- Start Screen -->
            <div id="startScreen" class="overlay">

                <div class="game-icon">
                    🐸
                </div>

                <h1>Tap to Jump</h1>

                <p>
                    Tap anywhere to jump over the obstacles.
                </p>

                <button id="startButton" class="primary-button">
                    PLAY
                </button>

            </div>


            <!-- Game Over Screen -->
            <div id="gameOverScreen" class="overlay hidden">

                <div class="game-over-icon">
                    💥
                </div>

                <h2>Game Over</h2>

                <div class="final-score-label">
                    YOUR SCORE
                </div>

                <div id="finalScore" class="final-score">
                    0
                </div>

                <div class="best-result">
                    BEST:
                    <span id="finalBestScore">0</span>
                </div>

                <button id="restartButton" class="primary-button">
                    PLAY AGAIN
                </button>

            </div>

        </section>


        <!-- Bottom Info -->
        <section class="bottom-panel">

            <div class="stat-box">
                <span class="stat-icon">🏆</span>

                <div>
                    <div class="stat-title">
                        BEST SCORE
                    </div>

                    <div id="bottomBestScore" class="stat-value">
                        0
                    </div>
                </div>
            </div>


            <div class="stat-box">
                <span class="stat-icon">👆</span>

                <div>
                    <div class="stat-title">
                        CONTROL
                    </div>

                    <div class="stat-value">
                        TAP
                    </div>
                </div>
            </div>

        </section>

    </main>

    <script src="game.js"></script>

</body>
</html>

"style.css"

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

    background: #0d1117;
    color: white;

    user-select: none;
    touch-action: manipulation;
}

button {
    font-family: inherit;
}

.app {
    width: 100%;
    max-width: 520px;
    height: 100dvh;
    margin: 0 auto;

    display: flex;
    flex-direction: column;

    background:
        linear-gradient(
            180deg,
            #101722 0%,
            #0d1117 100%
        );

    overflow: hidden;
}


/* =========================
   TOP BAR
========================= */

.topbar {
    height: 70px;
    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 12px 18px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.profile {
    display: flex;
    align-items: center;
    gap: 11px;
}

.avatar {
    width: 42px;
    height: 42px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #2aabee;

    color: white;

    font-size: 18px;
    font-weight: 700;

    overflow: hidden;
}

.avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.username {
    font-size: 15px;
    font-weight: 700;
}

.player-label {
    margin-top: 2px;

    font-size: 11px;
    color: #8994a3;
}

.icon-button {
    width: 42px;
    height: 42px;

    border: none;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.07);

    color: white;

    font-size: 18px;

    cursor: pointer;
}


/* =========================
   SCORE
========================= */

.score-area {
    flex-shrink: 0;

    text-align: center;

    padding: 9px 0 7px;
}

.score-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;

    color: #7f8a99;
}

.score {
    margin-top: -2px;

    font-size: 36px;
    line-height: 40px;

    font-weight: 800;
}

.best-score {
    font-size: 11px;
    color: #7f8a99;
}

.best-score span {
    color: #b7c0cc;
    font-weight: 700;
}


/* =========================
   GAME
========================= */

.game-container {
    position: relative;

    flex: 1;

    min-height: 0;

    margin: 0 12px;

    border-radius: 20px;

    overflow: hidden;

    background: #65c8e8;

    box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.3);

    touch-action: none;
}

canvas {
    display: block;

    width: 100%;
    height: 100%;
}


/* =========================
   OVERLAYS
========================= */

.overlay {
    position: absolute;

    inset: 0;

    z-index: 10;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 30px;

    background:
        rgba(8, 14, 22, 0.45);

    backdrop-filter: blur(5px);
}

.hidden {
    display: none;
}

.game-icon,
.game-over-icon {
    font-size: 64px;

    margin-bottom: 12px;
}

.overlay h1 {
    font-size: 31px;

    font-weight: 900;

    margin-bottom: 8px;
}

.overlay h2 {
    font-size: 29px;

    font-weight: 900;

    margin-bottom: 8px;
}

.overlay p {
    max-width: 280px;

    color: #d3dae2;

    font-size: 14px;
    line-height: 21px;

    margin-bottom: 24px;
}


/* =========================
   BUTTON
========================= */

.primary-button {
    min-width: 180px;

    padding: 15px 28px;

    border: none;
    border-radius: 14px;

    background: #2aabee;

    color: white;

    font-size: 16px;
    font-weight: 800;

    cursor: pointer;

    box-shadow:
        0 7px 20px rgba(42, 171, 238, 0.3);

    transition:
        transform 0.1s,
        opacity 0.1s;
}

.primary-button:active {
    transform: scale(0.95);
    opacity: 0.85;
}


/* =========================
   GAME OVER
========================= */

.final-score-label {
    margin-top: 8px;

    color: #8e99a8;

    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

.final-score {
    font-size: 48px;
    font-weight: 900;

    margin-top: 2px;
}

.best-result {
    color: #8e99a8;

    font-size: 12px;

    margin-bottom: 25px;
}

.best-result span {
    color: white;
    font-weight: 700;
}


/* =========================
   BOTTOM PANEL
========================= */

.bottom-panel {
    flex-shrink: 0;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 10px;

    padding: 12px;
}

.stat-box {
    display: flex;
    align-items: center;

    gap: 10px;

    padding: 11px 13px;

    border-radius: 14px;

    background: rgba(255, 255, 255, 0.05);
}

.stat-icon {
    font-size: 21px;
}

.stat-title {
    color: #7e8998;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 0.5px;
}

.stat-value {
    margin-top: 2px;

    font-size: 13px;

    font-weight: 800;
}


/* =========================
   SMALL SCREENS
========================= */

@media (max-height: 650px) {

    .topbar {
        height: 58px;
        padding: 8px 15px;
    }

    .avatar {
        width: 36px;
        height: 36px;
    }

    .score {
        font-size: 30px;
        line-height: 32px;
    }

    .score-area {
        padding: 5px 0;
    }

    .bottom-panel {
        padding: 8px;
    }

    .game-icon,
    .game-over-icon {
        font-size: 48px;
    }

    .overlay h1 {
        font-size: 26px;
    }
}

"game.js"

"use strict";

/*
    TAP TO JUMP
    Telegram Mini App Game

    Features:
    - Touch controls
    - Keyboard controls
    - Random obstacles
    - Collision detection
    - Score
    - Best score
    - Telegram user integration
    - Telegram fullscreen support
    - Sound toggle
*/


/* =========================
   TELEGRAM
========================= */

const tg = window.Telegram?.WebApp;

if (tg) {
    tg.ready();
    tg.expand();

    // Try to enable fullscreen where Telegram supports it
    try {
        if (tg.requestFullscreen) {
            tg.requestFullscreen();
        }
    } catch (error) {
        console.log("Fullscreen unavailable");
    }
}


/* =========================
   DOM
========================= */

const canvas = document.getElementById("gameCanvas");

const ctx = canvas.getContext("2d");

const gameContainer =
    document.getElementById("gameContainer");

const startScreen =
    document.getElementById("startScreen");

const gameOverScreen =
    document.getElementById("gameOverScreen");

const startButton =
    document.getElementById("startButton");

const restartButton =
    document.getElementById("restartButton");

const scoreElement =
    document.getElementById("score");

const bestScoreElement =
    document.getElementById("bestScore");

const bottomBestScoreElement =
    document.getElementById("bottomBestScore");

const finalScoreElement =
    document.getElementById("finalScore");

const finalBestScoreElement =
    document.getElementById("finalBestScore");

const usernameElement =
    document.getElementById("username");

const avatarElement =
    document.getElementById("avatar");

const soundButton =
    document.getElementById("soundButton");


/* =========================
   GAME STATE
========================= */

let gameWidth = 0;
let gameHeight = 0;

let animationId = null;

let lastTime = 0;

let gameRunning = false;

let gameStarted = false;

let score = 0;

let bestScore =
    Number(localStorage.getItem("tapJumpBest")) || 0;

let soundEnabled =
    localStorage.getItem("tapJumpSound") !== "false";


/* =========================
   PLAYER
========================= */

const player = {

    x: 0,

    y: 0,

    width: 42,

    height: 42,

    velocityY: 0,

    gravity: 0.55,

    jumpPower: -10.5,

    rotation: 0

};


/* =========================
   WORLD
========================= */

let groundY = 0;

let obstacles = [];

let obstacleTimer = 0;

let obstacleInterval = 1500;

let gameSpeed = 4;

let distanceSinceScore = 0;


/* =========================
   SOUND
========================= */

let audioContext = null;

function playSound(
    frequency,
    duration,
    type = "sine"
) {

    if (!soundEnabled) {
        return;
    }

    try {

        if (!audioContext) {
            audioContext =
                new (
                    window.AudioContext ||
                    window.webkitAudioContext
                )();
        }

        const oscillator =
            audioContext.createOscillator();

        const gain =
            audioContext.createGain();

        oscillator.type = type;

        oscillator.frequency.value =
            frequency;

        gain.gain.setValueAtTime(
            0.08,
            audioContext.currentTime
        );

        gain.gain.exponentialRampToValueAtTime(
            0.001,
            audioContext.currentTime + duration
        );

        oscillator.connect(gain);

        gain.connect(audioContext.destination);

        oscillator.start();

        oscillator.stop(
            audioContext.currentTime + duration
        );

    } catch (error) {
        console.log("Audio unavailable");
    }
}


/* =========================
   TELEGRAM USER
========================= */

function loadTelegramUser() {

    if (!tg || !tg.initDataUnsafe) {
        return;
    }

    const user =
        tg.initDataUnsafe.user;

    if (!user) {
        return;
    }

    let displayName =
        user.first_name || "Player";

    if (user.last_name) {
        displayName +=
            " " + user.last_name;
    }

    usernameElement.textContent =
        displayName;

    if (user.photo_url) {

        avatarElement.innerHTML =
            `<img src="${user.photo_url}" alt="Avatar">`;

    } else {

        avatarElement.textContent =
            displayName.charAt(0).toUpperCase();

    }
}


/* =========================
   BEST SCORE
========================= */

function updateBestScoreUI() {

    bestScoreElement.textContent =
        bestScore;

    bottomBestScoreElement.textContent =
        bestScore;

    finalBestScoreElement.textContent =
        bestScore;
}


/* =========================
   CANVAS RESIZE
========================= */

function resizeCanvas() {

    const rect =
        gameContainer.getBoundingClientRect();

    const dpr =
        Math.min(window.devicePixelRatio || 1, 2);

    gameWidth =
        rect.width;

    gameHeight =
        rect.height;

    canvas.width =
        gameWidth * dpr;

    canvas.height =
        gameHeight * dpr;

    canvas.style.width =
        gameWidth + "px";

    canvas.style.height =
        gameHeight + "px";

    ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );

    groundY =
        gameHeight - 55;

    if (!gameRunning) {

        player.x =
            gameWidth * 0.22;

        player.y =
            groundY - player.height;

    }
}


/* =========================
   RESET GAME
========================= */

function resetGame() {

    score = 0;

    scoreElement.textContent =
        "0";

    obstacles = [];

    obstacleTimer = 0;

    obstacleInterval = 1500;

    gameSpeed = 4;

    distanceSinceScore = 0;

    player.x =
        gameWidth * 0.22;

    player.y =
        groundY - player.height;

    player.velocityY =
        0;

    player.rotation =
        0;
}


/* =========================
   START GAME
========================= */

function startGame() {

    resetGame();

    startScreen.classList.add("hidden");

    gameOverScreen.classList.add("hidden");

    gameRunning = true;

    gameStarted = true;

    lastTime =
        performance.now();

    playSound(
        500,
        0.12
    );

    cancelAnimationFrame(
        animationId
    );

    animationId =
        requestAnimationFrame(
            gameLoop
        );
}


/* =========================
   JUMP
========================= */

function jump() {

    if (!gameRunning) {
        return;
    }

    player.velocityY =
        player.jumpPower;

    playSound(
        450,
        0.08
    );
}


/* =========================
   CREATE OBSTACLE
========================= */

function createObstacle() {

    const width =
        30 + Math.random() * 25;

    const height =
        35 + Math.random() * 45;

    obstacles.push({

        x:
            gameWidth + width,

        y:
            groundY - height,

        width:
            width,

        height:
            height,

        passed:
            false

    });
}


/* =========================
   COLLISION
========================= */

function checkCollision(
    a,
    b
) {

    const padding = 7;

    return (

        a.x + padding <
        b.x + b.width - padding

        &&

        a.x + a.width - padding >
        b.x + padding

        &&

        a.y + padding <
        b.y + b.height

        &&

        a.y + a.height >
        b.y + padding

    );
}


/* =========================
   GAME OVER
========================= */

function endGame() {

    gameRunning = false;

    cancelAnimationFrame(
        animationId
    );

    if (score > bestScore) {

        bestScore =
            score;

        localStorage.setItem(
            "tapJumpBest",
            bestScore
        );

        playSound(
            800,
            0.2
        );

    } else {

        playSound(
            150,
            0.25,
            "square"
        );

    }

    finalScoreElement.textContent =
        score;

    updateBestScoreUI();

    gameOverScreen.classList.remove(
        "hidden"
    );

    /*
        Future Telegram leaderboard request
        can be sent here.

        Example:

        tg.sendData(JSON.stringify({
            score: score
        }));

        Your backend should validate
        the score before storing it.
    */
}


/* =========================
   UPDATE GAME
========================= */

function update(delta) {

    /*
        PLAYER PHYSICS
    */

    player.velocityY +=
        player.gravity *
        delta;

    player.y +=
        player.velocityY *
        delta;

    if (
        player.y + player.height >=
        groundY
    ) {

        player.y =
            groundY - player.height;

        player.velocityY =
            0;

    }


    /*
        OBSTACLE SPAWNING
    */

    obstacleTimer +=
        delta * 16.67;

    if (
        obstacleTimer >=
        obstacleInterval
    ) {

        createObstacle();

        obstacleTimer =
            0;

        obstacleInterval =
            1200 +
            Math.random() * 800;

    }


    /*
        MOVE OBSTACLES
    */

    for (
        let i = obstacles.length - 1;
        i >= 0;
        i--
    ) {

        const obstacle =
            obstacles[i];

        obstacle.x -=
            gameSpeed *
            delta;


        /*
            SCORE
        */

        if (
            !obstacle.passed &&
            obstacle.x +
            obstacle.width <
            player.x
        ) {

            obstacle.passed =
                true;

            score++;

            scoreElement.textContent =
                score;

            playSound(
                700,
                0.05
            );


            /*
                Increase difficulty
            */

            if (
                score % 5 ===
                0
            ) {

                gameSpeed +=
                    0.3;

            }

        }


        /*
            COLLISION
        */

        if (
            checkCollision(
                player,
                obstacle
            )
        ) {

            endGame();

            return;

        }


        /*
            REMOVE OLD OBSTACLES
        */

        if (
            obstacle.x +
            obstacle.width <
            -50
        ) {

            obstacles.splice(
                i,
                1
            );

        }

    }


    /*
        PLAYER ROTATION
    */

    player.rotation +=
        player.velocityY *
        0.015;

}


/* =========================
   DRAW BACKGROUND
========================= */

function drawBackground() {

    /*
        Sky
    */

    const sky =
        ctx.createLinearGradient(
            0,
            0,
            0,
            gameHeight
        );

    sky.addColorStop(
